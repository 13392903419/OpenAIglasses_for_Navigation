# 阿里云 DashScope API Key
DASHSCOPE_API_KEY=sk-82107b037f5847ee90deb81f6f976e0f

# 可选配置
# 自动启动电脑麦克风+扬声器（开发模式，无 ESP32 时用）。设为 0 可禁用
AUTO_PC_AUDIO=1

AIGLASS_MASK_MIN_AREA=1500
AIGLASS_MASK_MORPH=3
AIGLASS_MASK_MISS_TTL=6
AIGLASS_PANEL_SCALE=0.65
TTS_INTERVAL_SEC=1.0
ENABLE_TTS=true


# YOLO-E 混合精度：fp16(推荐) | bf16(部分GPU不支持) | off(禁用)
AIGLASS_AMP=fp16

BLIND_PATH_MODEL=model/yolo-seg.pt
OBSTACLE_MODEL=model/yoloe-11l-seg.pt
YOLOE_MODEL_PATH=model/yoloe-11l-seg.

CUDA_VISIBLE_DEVICES=0

# IMU UDP 端口（端口被占用时自动尝试 12346-12349）
UDP_PORT=12345